generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./barbershop.db"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String
  role         String        @default("client")
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  service   String
  barber    String
  date      String
  time      String
  notes     String?
  guestName String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model BarberApplication {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String
  phone            String
  storeName        String
  storeAddress     String
  storeCity        String
  storeState       String
  storeZip         String
  storePhone       String
  yearsExperience  String
  specialties      String
  bio              String
  licenseFile      String
  insuranceFile    String
  certificateFiles String
  status           String    @default("pending")
  adminNote        String?
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?
}
